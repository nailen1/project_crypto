# Crypto ETL Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# DATABASE CONFIGURATION (Required)
# =============================================================================

# PostgreSQL Database Settings
DB_NAME=database_crypto          # Database name for crypto data
DB_USER=your_name                # Database username
DB_PASSWORD=your_secure_password # Database password (use strong password)

# Database Connection Settings (Optional - defaults provided)
DB_HOST=localhost                # Database host (default: localhost)
DB_PORT=5432                     # Database port (default: 5432)

# =============================================================================
# PGADMIN CONFIGURATION (Required for Docker)
# =============================================================================

# pgAdmin Web Interface Settings
PGADMIN_EMAIL=admin@example.com  # pgAdmin login email
PGADMIN_PASSWORD=admin_password  # pgAdmin login password

# =============================================================================
# DEVELOPMENT SETTINGS (Optional)
# =============================================================================

# Python Environment
PYTHONUNBUFFERED=1               # Disable Python output buffering
PYTHONDONTWRITEBYTECODE=1        # Prevent .pyc file creation

# =============================================================================
# SECURITY NOTES
# =============================================================================
# 
# 1. Never commit the actual .env file to version control
# 2. Use strong, unique passwords for production
# 3. Consider using environment-specific configurations
# 4. Rotate credentials regularly
# 
# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
# 
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual values
# 3. Run: docker compose up -d
# 4. Access pgAdmin at: http://localhost:5050
# 5. Access Jupyter at: http://localhost:8889
# 
# =============================================================================
