# Database Configuration (EC2 PostgreSQL)
DB_HOST=your_docker_container_postgres_service_name
DB_PORT=5432
DB_USER=your_db_username
DB_PASSWORD=your_secure_password
DB_NAME=database_crypto

# pgAdmin Configuration
PGADMIN_EMAIL=your_email@example.com
PGADMIN_PASSWORD=your_pgadmin_password

# AWS Configuration
AWS_ACCESS_KEY=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Project Configuration
PROJECT_ROOT=/path/to/your/project/crypto

# Binance API Configuration (optional)
# BINANCE_API_KEY=your_binance_api_key
# BINANCE_SECRET_KEY=your_binance_secret_key

# Additional Environment Variables (if needed)
# ENVIRONMENT=development
# DEBUG=True
# LOG_LEVEL=INFO